{
  "opencollection": "1.0.0",
  "info": {
    "name": "Northflank Addons Jobs API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Jobs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List jobs in a project",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.northflank.com/v1/projects/:projectId/jobs",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List jobs in a project"
        },
        {
          "info": {
            "name": "Create a job",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.northflank.com/v1/projects/:projectId/jobs",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a job"
        },
        {
          "info": {
            "name": "Run a job",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.northflank.com/v1/projects/:projectId/jobs/:jobId/run",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "jobId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Run a job"
        }
      ]
    }
  ],
  "bundled": true
}